 }
+
+gboolean apt_install(GPtrArray *packages, GError **error) {
+  g_autoptr(GSubprocessLauncher) launcher = NULL;
+  g_autoptr(GSubprocess) process = NULL;
+
+  if (!packages || packages->len == 0) {
+      g_warning("List of packages to install is NULL or empty.");
+      return FALSE;
+  }
+
+  /* Create space for 8 leading arguments of the install command, the number of 
+   * packages and a NULL terminator. 
+   */
+  int total = 4 + packages->len + 1;
+  gchar **argv = g_new(gchar *, total);
+  int pos = 0;
+  argv[pos++] = "/usr/bin/pkexec";
+  argv[pos++] = "apt";
+  argv[pos++] = "install";
+  argv[pos++] = "-y";
+  for (int i = 0; i < packages->len; i++)
+    argv[pos++] = (gchar *)g_ptr_array_index(packages, i);
+  argv[pos] = NULL;
+
+  launcher = g_subprocess_launcher_new(G_SUBPROCESS_FLAGS_NONE);
+  g_subprocess_launcher_unsetenv(launcher, "SHELL");
+
+  g_subprocess_launcher_setenv(launcher, "DEBCONF_NONINTERACTIVE_SEEN", "true", TRUE);
+  g_subprocess_launcher_setenv(launcher, "DEBIAN_FRONTEND", "noninteractive", TRUE);
+
+  process =
+      g_subprocess_launcher_spawnv(launcher, (const gchar *const *)argv, error);
+  g_free(argv);
+
+  if (!process) {
+    g_prefix_error(error, "Failed to create apt install process: ");
+    return FALSE;
+  }
+
+  if (!g_subprocess_wait_check(process, NULL, error)) {
+    g_prefix_error(error, "apt install failed: ");
+    return FALSE;
+  }
+
+  return TRUE;
+}
