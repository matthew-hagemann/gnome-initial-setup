+gchar **
+parse_language_list(void)
+{
+    const gchar *filepath = "/usr/share/language-selector/data/languagelist";
+    gchar *contents = NULL;
+    gsize length;
+    GError *error = NULL;
+
+    if (!g_file_get_contents(filepath, &contents, &length, &error)) {
+        g_printerr("Error reading file: %s\n", error->message);
+        g_error_free(error);
+        return NULL;
+    }
+
+    gchar **lines = g_strsplit(contents, "\n", -1);
+    g_free(contents);
+
+    GPtrArray *codes = g_ptr_array_new_with_free_func(g_free);
+    for (gchar **line = lines; *line != NULL; line++) {
+        gchar *trimmed = g_strstrip(*line);
+        
+        /* Skip empty lines and commented out lines */
+        if (trimmed[0] == '\0' || trimmed[0] == '#') {
+            continue;
+        }
+
+        gchar **tokens = g_strsplit(trimmed, ";", -1);
+        gint token_count = g_strv_length(tokens);
+
+        /* Language code we use is the 4th entry in a ; delimited list */
+        if (token_count >= 4) {
+            g_ptr_array_add(codes, g_strdup(tokens[3]));
+        }
+        g_strfreev(tokens);
+    }
+    g_strfreev(lines);
+
+    g_ptr_array_add(codes, NULL);
+
+    /* gchar ** is the required type of the function consuming this output */
+    return (gchar **) g_ptr_array_free(codes, FALSE);
+}
