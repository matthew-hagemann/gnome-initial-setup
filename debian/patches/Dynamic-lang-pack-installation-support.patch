+static GPtrArray *
+get_lang_support_packages_for_locale(const gchar *locale, GError **error, GCancellable *cancellable)
+{
+  g_autoptr (GSubprocess) subprocess = NULL;
+  g_autoptr (GError) local_error = NULL;
+  g_autofree gchar *stdout_buf = NULL;
+  g_autofree gchar *stderr_buf = NULL;
+
+  subprocess = g_subprocess_new(
+    G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_PIPE,
+    &local_error,
+    "/usr/bin/check-language-support",
+    "-l",
+    locale,
+    NULL
+  );
+
+  if (local_error) {
+    g_propagate_error (error, g_steal_pointer(&local_error));
+    return NULL;
+  }
+
+  if (!g_subprocess_communicate_utf8 (subprocess, NULL, cancellable, &stdout_buf, &stderr_buf, error)) {
+    g_prefix_error_literal (&local_error, "Failed to communicate with check-language-support: ");
+    g_propagate_error (error, g_steal_pointer (&local_error));
+    return NULL;
+  }
+
+  if (!g_subprocess_wait_check(subprocess, cancellable, error))
+    return NULL;
+
+  if (stderr_buf && *stderr_buf != '\0') {
+    g_warning ("check-language-support stderr: %s", stderr_buf);
+  }
+
+  if (!stdout_buf || *stdout_buf == '\0') {
+    return g_ptr_array_new_with_free_func (g_free);
+  }
+
+  g_auto (GStrv) packages_split = g_strsplit (g_strstrip (stdout_buf), " ", -1);
+  return g_ptr_array_new_take_null_terminated ((gpointer *) g_steal_pointer (&packages_split), g_free);
+}
+
+static gboolean
+install_language_support(const gchar *locale, GError **error, GCancellable *cancellable)
+{
+  g_autoptr (GError) local_error = NULL;
+  g_autoptr (GPtrArray) packages_array = get_lang_support_packages_for_locale(locale, &local_error, cancellable);
+
+  if (local_error) {
+    g_propagate_error (error, g_steal_pointer(&local_error));
+    return FALSE;
+  }
+
+  if (!packages_array || packages_array->len == 0) {
+    g_warning ("No valid packages to install for locale: %s", locale);
+    return TRUE;
+  }
+
+  if (!apt_get_install (packages_array, error, cancellable)) {
+    g_prefix_error_literal (error, "Error installing language support: ");
+    return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+installation_task_async (GTask      *task,
+                         gpointer    source_object,
+                         gpointer    task_data,
+                         GCancellable *cancellable)
+{
+  const gchar *locale = task_data;
+  g_autoptr (GError) error = NULL;
+
+  if (g_cancellable_set_error_if_cancelled (cancellable, &error)) {
+    g_task_return_error (task, g_steal_pointer(&error));
+    return;
+  }
+
+  if (!install_language_support (locale, &error, cancellable)) {
+    g_task_return_error (task, g_steal_pointer (&error));
+    return;
+  }
+
+  g_task_return_boolean(task, TRUE);
+}
+
+static void
+installation_task_done (GObject    *source_object,
+                        GAsyncResult *res,
+                        gpointer    user_data)
+{
+  CcLanguageChooser *chooser = user_data;
+  g_autoptr (GError) error = NULL;
+
+  if (!g_task_propagate_boolean (G_TASK(res), &error)) {
+    if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+      sync_all_checkmarks (chooser, FALSE, _("Canceled additional downloads"));
+    } else {
+      g_warning ("Installation failed: %s", error->message);
+      sync_all_checkmarks (chooser, FALSE, _("Unable to download additional language packs"));
+    }
+  } else {
+    g_object_notify_by_pspec (G_OBJECT(chooser), obj_props[PROP_LANGUAGE]);
+    sync_all_checkmarks (chooser, FALSE, NULL);
+  } 
+}
