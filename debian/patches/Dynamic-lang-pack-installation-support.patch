+static gchar *
+get_lang_support_output(const gchar *locale)
+{
+  g_autoptr(GSubprocess) subprocess = NULL;
+  g_autoptr(GError) error = NULL;
+  g_autofree gchar *stdout_buf = NULL;
+  g_autofree gchar *stderr_buf = NULL;
+
+  subprocess = g_subprocess_new(
+    G_SUBPROCESS_FLAGS_STDOUT_PIPE | G_SUBPROCESS_FLAGS_STDERR_PIPE,
+    &error,
+    "/usr/bin/check-language-support",
+    "-l",
+    locale,
+    NULL
+  );
+
+  if (!g_subprocess_communicate_utf8(subprocess, NULL, NULL, &stdout_buf, &stderr_buf, &error)) {
+      g_warning("Failed to communicate with subprocess: %s", error->message);
+      return NULL;
+  }
+
+  if (stderr_buf && *stderr_buf != '\0') {
+    g_warning("check-language-support stderr: %s", stderr_buf);
+  }
+
+  return g_steal_pointer (&stdout_buf);
+}
+
+gboolean
+install_language_support(const gchar *locale, GError **error) {
+  g_autofree gchar *packages_str = get_lang_support_output(locale);
+
+  if (!packages_str || *packages_str == '\0') {
+     g_warning("No packages to install for locale: %s", locale);
+     return TRUE;
+  }
+
+  g_auto (GStrv) packages_split = g_strsplit(packages_str, " ", -1);
+  g_autoptr (GPtrArray) packages_array = g_ptr_array_new_with_free_func(g_free);
+
+  for (int i = 0; packages_split[i] != NULL; i++) {
+     gchar *trimmed = g_strstrip(packages_split[i]);
+     if (*trimmed != '\0')
+       g_ptr_array_add (packages_array, g_strdup(trimmed));
+  }
+
+  if (packages_array->len == 0) {
+     g_warning ("No valid packages to install for locale: %s", locale);
+     return TRUE;
+  }
+
+  if (!apt_get_install (packages_array, error)) {
+     g_prefix_error_literal (error, "Error installing language support: ");
+     return FALSE;
+  }
+
+  return TRUE;
+}
+
+static void
+installation_task_async (GTask      *task,
+                         gpointer    source_object,
+                         gpointer    task_data,
+                         GCancellable *cancellable)
+{
+  const gchar *locale = task_data;
+  g_autoptr (GError) error = NULL;
+
+  if (!install_language_support (locale, &error)) {
+    g_task_return_error (task, g_steal_pointer (&error));
+    return;
+  }
+
+  g_task_return_boolean(task, TRUE);
+}
+
+static void
+installation_task_done (GObject    *source_object,
+                        GAsyncResult *res,
+                        gpointer    user_data)
+{
+  CcLanguageChooser *chooser = user_data;
+  g_autoptr (GError) error = NULL;
+
+  if (!g_task_propagate_boolean (G_TASK(res), &error)) {
+    g_warning ("Installation failed: %s", error->message);
+    sync_all_checkmarks (chooser, false, _("Unable to download additional language packs"));
+  } else {
+    sync_all_checkmarks (chooser, false, NULL);
+  } 
+
+  gtk_widget_set_sensitive (GTK_WIDGET(chooser), TRUE);
+}
